module(
    name = "sonic-mgmt-common",
    version = "1.0.2",
    bazel_compatibility = [
        ">=8.5.1",
        "<=8.5.1",
    ],
)

bazel_dep(name = "bazel_lib", version = "3.2.2")
bazel_dep(name = "bazel_skylib", version = "1.9.2")
bazel_dep(name = "gazelle", version = "0.54.0.sonic.2")
bazel_dep(name = "openconfig_goyang", version = "0.0.0.sonic.2-20200309174518-a00bece872fc", repo_name = "com_github_openconfig_goyang")
bazel_dep(name = "openconfig_ygot", version = "0.7.1.sonic.2", repo_name = "com_github_openconfig_ygot")
bazel_dep(name = "libyang", version = "3.12.2.sonic.9")
bazel_dep(name = "oc-pyang", version = "0.1.10.sonic.2", repo_name = "oc_pyang")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "rules_go", version = "0.65.0.sonic.2", repo_name = "io_bazel_rules_go")
bazel_dep(name = "rules_cc", version = "0.2.22")
bazel_dep(name = "rules_distroless", version = "0.9.4.sonic.26")
bazel_dep(name = "rules_python", version = "1.9.0.sonic.2")
bazel_dep(name = "rules_shell", version = "0.8.0")
bazel_dep(name = "sonic-build-infra", version = "0.0.44-35726399908a3beb947174e9359f902077928289", repo_name = "sonic_build_infra")
bazel_dep(name = "sonic-yang-models", version = "1.0.1-dd732f9512a84966487951250adae8e3e5c9943e", repo_name = "sonic_yang_models")
bazel_dep(name = "tar.bzl", version = "0.10.5.sonic.2")

# Reuse SONiC's reviewed CGo/header repair and TAR toolchain selection.
single_version_override(
    module_name = "rules_go",
    version = "0.65.0.sonic.2",
)

single_version_override(
    module_name = "tar.bzl",
    version = "0.10.5.sonic.2",
)

gcc = use_extension("@sonic_build_infra//toolchains/gcc:extensions.bzl", "gcc")
use_repo(gcc, "gcc_toolchains")

register_toolchains("@gcc_toolchains//:all")

go_sdk = use_extension("@io_bazel_rules_go//go:extensions.bzl", "go_sdk")
go_sdk.download(version = "1.26.0")

go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_mod = "//:go.mod")

# goyang and ygot use their public owners above. These remaining overrides
# preserve the existing gNMI and unrelated Go dependency behavior.
go_patches = use_extension("@gazelle//:extensions.bzl", "go_deps", dev_dependency = True)
go_patches.gazelle_override(
    directives = ["gazelle:proto disable_global"],
    path = "github.com/openconfig/gnmi",
)

# These are the existing Make/vendor patches, applied to isolated dependency
# repositories. Build actions never modify go.mod, vendor, or the checkout.
go_patches.module_override(
    patch_strip = 1,
    patches = ["//patches:jsonquery.patch"],
    path = "github.com/antchfx/jsonquery",
)
go_patches.module_override(
    patch_strip = 1,
    patches = ["//patches:xmlquery.patch"],
    path = "github.com/antchfx/xmlquery",
)
go_patches.module_override(
    patch_strip = 1,
    patches = ["//patches:xpath.patch"],
    path = "github.com/antchfx/xpath",
)

use_repo(go_deps, "af_inet_netaddr", "com_github_antchfx_jsonquery", "com_github_antchfx_xmlquery", "com_github_antchfx_xpath", "com_github_godbus_dbus_v5", "com_github_golang_glog", "com_github_google_go_cmp", "com_github_kylelemons_godebug", "com_github_maruel_natural", "com_github_openconfig_gnmi", "com_github_philopon_go_toposort", "com_github_pkg_profile", "com_github_redis_go_redis_v9", "com_github_workiva_go_datastructures", "org_golang_google_grpc", "org_golang_x_net", "org_golang_x_sys", "org_golang_x_text")

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(
    is_default = True,
    python_version = "3.13",
)
use_repo(python, "python_3_13")

pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")
pip.parse(
    hub_name = "mgmt_pip",
    python_version = "3.13",
    requirements_lock = "//:requirements_lock.txt",
)
use_repo(pip, "mgmt_pip")

# Private test service, using the same immutable Debian snapshot as the shared
# toolchain. Redis is a declared test runtime, never a worker-owned service.
test_apt = use_extension("//tools/test:apt.bzl", "apt")
test_apt.import_lock(lock = "//tools/test:apt.lock.json")
use_repo(test_apt, "mgmt_test_deps")

# Normalizing Redis package archives uses zstd in the fixture repository mapping.
package_tools = use_extension("@bazel_lib//lib:extensions.bzl", "toolchains")
use_repo(package_tools, "zstd_toolchains")

tar_toolchains = use_extension("@tar.bzl//tar:extensions.bzl", "toolchains")
use_repo(tar_toolchains, "bsd_tar_toolchains")

register_toolchains("@bsd_tar_toolchains//:all")
