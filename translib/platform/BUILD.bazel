load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "platform",
    srcs = [
        "platform.go",
    ],
    importpath = "github.com/Azure/sonic-mgmt-common/translib/platform",
    visibility = ["//visibility:public"],
    deps = [
        "//translib/db",
        "//translib/internal/apis",
        "//translib/log",
        "//translib/tlerr",
        "@com_github_golang_glog//:glog",
    ],
)

go_test(
    name = "platform_test",
    srcs = [
        "platform_test.go",
    ],
    data = glob(["testdata/**"]),
    embed = [":platform"],
    visibility = ["//visibility:public"],
    deps = [
        "//translib",
        "@com_github_google_go_cmp//cmp",
    ],
)

alias(
    name = "go_default_library",
    actual = ":platform",
    visibility = ["//visibility:public"],
)
